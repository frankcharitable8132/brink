<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Brink</AssemblyName>
    <RootNamespace>Brink</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\brink.ico</ApplicationIcon>
    <Version>0.6.0</Version>
    <Description>Claude Code, Codex and Cursor usage limits at a glance, from the screen edge.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Strings\*.strings" />
    <None Remove="Resources\brink.ico" />
    <Resource Include="Resources\Images\*.png" />
  </ItemGroup>

</Project>
